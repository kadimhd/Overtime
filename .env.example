# Local dev: run a Postgres instance yourself (e.g. `docker run -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres`)
# and use DATABASE_URL="postgresql://postgres:postgres@localhost:5432/overtime"
# Production: paste your hosted Postgres connection string (Neon, Supabase, Vercel Postgres, ...)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# MOCK | DIBSY | FATORA — real adapters need QCB-licensed gateway credentials
PAYMENT_GATEWAY="MOCK"
